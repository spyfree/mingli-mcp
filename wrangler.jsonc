{
  "name": "mingli-mcp-container",
  "main": "cloudflare/container-worker.mjs",
  "compatibility_date": "2026-03-07",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "routes": [
    {
      "pattern": "mcp.lee.locker",
      "custom_domain": true
    }
  ],
  // 每日触发 scheduled()，清理过期的 OAuth grant/token 记录（purgeExpiredData）
  "triggers": {
    "crons": ["17 19 * * *"]
  },
  "containers": [
    {
      "class_name": "MingliContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "vars": {
    // 每个license每日tools/call上限（软限制）
    "MCP_DAILY_QUOTA": "200"
  },
  // 与 mingli-paipan (Pages) 共享的license存储：校验售出的 ML- 格式 key
  "kv_namespaces": [
    {
      "binding": "LICENSES",
      "id": "32eaf27eecf4412dae5e39fb68710e79"
    },
    {
      // OAuth provider records are namespaced by client:/grant:/token: keys. Reusing the
      // existing namespace keeps this P0 deployable without migrating paid licenses.
      "binding": "OAUTH_KV",
      "id": "32eaf27eecf4412dae5e39fb68710e79"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MINGLI_CONTAINER",
        "class_name": "MingliContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MingliContainer"]
    }
  ]
}
